# Supabase — booking modal backend.
# Copy to .env.local and fill with your project's values
# (Supabase dashboard → Project Settings → API).
#
# Both are safe to expose to the browser, but the booking flow only ever
# uses them server-side, inside src/app/api/appointments/route.ts.
# The service_role key is NOT used by this app and must never be added here.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: overrides the canonical site URL used for SEO metadata.
# NEXT_PUBLIC_SITE_URL=https://bright-way-dental-clinic.vercel.app
